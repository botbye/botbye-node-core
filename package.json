{
  "name": "@botbye/node-core",
  "version": "2.2.1",
  "description": "BotBye! core module for Node.js",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "exports": {
    ".": {
      "import": "./src/index.js",
      "require": "./src/index.js",
      "types": "./src/index.d.ts"
    },
    "./node-http-client": {
      "import": "./src/BotFraud/HttpClients/Clients/NodeHttpClient/NodeHttpClient.js",
      "require": "./src/BotFraud/HttpClients/Clients/NodeHttpClient/NodeHttpClient.js",
      "types": "./src/BotFraud/HttpClients/Clients/NodeHttpClient/NodeHttpClient.d.ts"
    },
    "./fetch-http-client": {
      "import": "./src/BotFraud/HttpClients/Clients/FetchHttpClient/FetchHttpClient.js",
      "require": "./src/BotFraud/HttpClients/Clients/FetchHttpClient/FetchHttpClient.js",
      "types": "./src/BotFraud/HttpClients/Clients/FetchHttpClient/FetchHttpClient.d.ts"
    },
    "./utils": {
      "import": "./src/Shared/Global/Utils.js",
      "require": "./src/Shared/Global/Utils.js",
      "types": "./src/Shared/Global/Utils.d.ts"
    },
    "./phishing-node-http-client": {
      "import": "./src/Phishing/HttpClients/NodePhishingHttpClient.js",
      "require": "./src/Phishing/HttpClients/NodePhishingHttpClient.js",
      "types": "./src/Phishing/HttpClients/NodePhishingHttpClient.d.ts"
    },
    "./phishing-fetch-http-client": {
      "import": "./src/Phishing/HttpClients/FetchPhishingHttpClient.js",
      "require": "./src/Phishing/HttpClients/FetchPhishingHttpClient.js",
      "types": "./src/Phishing/HttpClients/FetchPhishingHttpClient.d.ts"
    }
  },
  "files": [
    "src",
    "LICENSE",
    "README.md"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://botbye.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/botbye/botbye-node-core"
  }
}
